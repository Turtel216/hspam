cabal-version:      3.0
name:               hspam
version:            0.1.0.0
synopsis:           A spam filter in Haskell
-- description:
license:            MIT
license-file:       LICENSE
author:             Dimitrios Papakonstantinou
maintainer:         papadimitrios216@gmail.com
-- copyright:
build-type:         Simple
-- extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Classifier
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.17.2.1,
        text >= 1.2 && <1.3,
        containers >=0.6 && < 0.7,
        directory >=1.3 && <1.4
    hs-source-dirs:   src
    default-language: Haskell2010

executable hspam
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.17.2.1,
        hspam,
        text >= 1.2 && <1.3,
        containers >=0.6 && < 0.7

    hs-source-dirs:   app
    default-language: Haskell2010

test-suite hspam-test
    import:           warnings
    default-language: Haskell2010
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.17.2.1,
        hspam
